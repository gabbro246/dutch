{
  "name": "dutch-card-game",
  "version": "1.3.76",
  "description": "Simple local multiplayer Dutch card game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:browser": "node --test e2e/browser-smoke.js",
    "benchmark:bots": "node scripts/bot-benchmark.js",
    "benchmark:roswell-versions": "node scripts/bot-benchmark.js --versions",
    "replay:bots": "node scripts/bot-replay.js",
    "tournament:bots": "node scripts/bot-benchmark.js --bot-versions"
  },
  "dependencies": {
    "express": "^4.18.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
